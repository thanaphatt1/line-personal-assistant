# Nonsecret checklist for the history-enabled Cloud Run factory.
# Disabled and intentionally incomplete. Never commit a filled copy.
PILOT_MODE=production
PILOT_LAUNCH_AUTHORIZED=false
PILOT_PROJECT_ID=YOUR_PROJECT_ID
PILOT_REGION=YOUR_REGION
PILOT_SERVICE_ACCOUNT=YOUR_RUNTIME_ACCOUNT
PILOT_LINE_OWNER_ID=YOUR_LINE_USER_ID
PILOT_SPREADSHEET_ID=YOUR_WORKBOOK_ID
PILOT_LEGACY_SPREADSHEET_ID=
PILOT_EXPENSE_SHEET_ID=0
PILOT_DATABASE_SHEET_ID=1
PILOT_SHEETS_MAX_ROWS=1001
PILOT_SHEET_SCHEMA_VERIFIED=false
PILOT_CONVERSATION_ENABLED=false
PILOT_STATE_CODEC_ENABLED=false
PILOT_STATE_RECORDS_ENABLED=false
PILOT_HISTORY_STATE_ENABLED=false
PILOT_HISTORY_ENABLED=false
PILOT_CALENDAR_ENABLED=false
PILOT_CALENDAR_ID=
PILOT_CALENDAR_READ_ALL_ENABLED=false
PILOT_CALENDAR_READ_IDS=[]
PILOT_CALENDAR_CONNECTIONS_ENABLED=false
PILOT_RESPONSE_REALIZATION_ENABLED=false
PILOT_MODEL_USAGE_GATES_ENABLED=true
PILOT_SAVED_EXPENSE_EDITS_ENABLED=false
PILOT_SAVED_CALENDAR_RESCHEDULE_ENABLED=false
PILOT_SAVED_EXPENSE_DELETE_ENABLED=false
PILOT_CATALOG_ALIASES_ENABLED=false
PILOT_RECORD_ACTIONS_ENABLED=false
PILOT_NAME_MATCHING_ENABLED=false
PILOT_ACTIVITY_MEMORY_ENABLED=false
# Sheets cannot conditionally compare-and-swap against outside collaborators.
# Enabling saved expense edits requires separately reviewed single-writer policy.
PILOT_SAVED_EXPENSE_EDIT_CONCURRENCY=off
PILOT_PROVISIONAL_CATEGORIES_ENABLED=false
PILOT_PROVISIONAL_MAPPING_ENABLED=false
PILOT_HISTORICAL_CATEGORIES_ENABLED=false
PILOT_PREVIOUS_EXPENSE_PRICES_ENABLED=false
# Fixed typed adapter contract; other model IDs are rejected.
PILOT_MODEL_ID=gpt-6-luna
PILOT_MODEL_MONTHLY_MICRO_USD=0
PILOT_MODEL_MAX_CALLS_DAY=20
PILOT_MODEL_MAX_CALLS_MONTH=300
